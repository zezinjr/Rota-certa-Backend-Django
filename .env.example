# .env.example
DEBUG=True
SECRET_KEY=seu-valor-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:123456@localhost:5432/route_monitoring
# Para voltar ao SQLite local:
# DATABASE_URL=sqlite:///db.sqlite3
GOOGLE_MAPS_API_KEY=sua-chave-da-routes-api-aqui
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes# Avisos pelo WhatsApp. Ver README. Sem as credenciais do provedor = desligado.
# Provedor: meta (oficial) ou evolution (Evolution API no Docker, número via QR code)
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=rotacerta
# Quais avisos enviar: departure, approaching, arriving
WHATSAPP_EVENTS=approaching,arriving
WHATSAPP_APPROACHING_MINUTES=10
