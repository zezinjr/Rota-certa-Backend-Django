# Copie para deploy/.env no servidor e preencha. Nunca versione o .env.

# Domínio apontado (registro A) para o IP elástico da EC2.
DOMAIN=rotacerta.exemplo.com.br

# --- Django ---
DEBUG=False
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=rotacerta.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://rotacerta.exemplo.com.br

# --- Banco (Postgres no próprio compose) ---
POSTGRES_DB=route_monitoring
POSTGRES_USER=rotacerta
POSTGRES_PASSWORD=troque-esta-senha
# Repita a senha acima aqui (host "db" = container do Postgres).
DATABASE_URL=postgres://rotacerta:troque-esta-senha@db:5432/route_monitoring

GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# --- WhatsApp (ver README do backend) ---
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Para usar a Evolution API: WHATSAPP_PROVIDER=evolution, preencha a chave
# e suba com --profile whatsapp. A URL abaixo é a rede interna do compose.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=rotacerta
WHATSAPP_EVENTS=approaching,arriving
WHATSAPP_APPROACHING_MINUTES=10

# --- Push no app (Firebase Cloud Messaging, ver deploy/README.md seção 5.1) ---
# Copie o JSON da conta de serviço para deploy/secrets/firebase.json no servidor.
FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase.json
PUSH_EVENTS=departure,approaching,arriving

# --- Imagem do backend (CI/CD). O deploy.sh escolhe a tag; normalmente não mexa. ---
# BACKEND_IMAGE=ghcr.io/zezinjr/rota-certa-backend-django
